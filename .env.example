# Scout EA — Local Environment Variables
# Copy to .env and fill in, or export them before `docker compose up`

# MCP server bearer token (generate via: openssl rand -hex 16)
EA_MCP_TOKEN=your-secret-token-here

# Optional: override DB path (default: /data/ea.sqlite in container)
# EA_DB_PATH=/data/ea.sqlite

# Optional: override web API port (default: 8765)
# EA_WEB_PORT=8765

# Optional: override MCP server port (default: 8766)
# EA_MCP_PORT=8766
